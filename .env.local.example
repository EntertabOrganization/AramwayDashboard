# Secret used to sign/verify the admin session JWT (jose HS256).
# Must match AramwayBackend's JWT_SECRET exactly — the dashboard verifies
# tokens issued by the real backend's /api/auth/login.
# Copy this file to .env.local and change the value for anything beyond local dev.
JWT_SECRET=dev-only-change-me-aramway-dashboard-secret

# Base URL of the AramwayBackend Express API this dashboard proxies to.
BACKEND_URL=http://localhost:4000
